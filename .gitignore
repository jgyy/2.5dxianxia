# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Embedded GLB texture copies extracted by Godot during import
assets/world/*_[0-9][0-9]_*_[0-9][0-9].png
assets/world/*_[0-9][0-9]_*_[0-9][0-9].png.import

# Local Python caches
__pycache__/
*.pyc

# Godot extracts embedded textures from regional GLBs during import
assets/landmarks/*_[0-9][0-9]_*_[0-9][0-9].png
assets/landmarks/*_[0-9][0-9]_*_[0-9][0-9].png.import

# Local desktop exports
build/

# Embedded texture extracted from the generated camp GLB
assets/props/camp_beacon_*.png
assets/props/camp_beacon_*.png.import
